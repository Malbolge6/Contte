// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Settings
  theme         String    @default("ORIGINAL") // DARK, LIGHT, ORIGINAL
  
  // Stripe
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  plan                   String    @default("FREE")
  hourlyRate             Float?    @default(0)

  accounts     Account[]
  sessions     Session[]
  transactions Transaction[]
  bills        Bill[]
  billGroups   BillGroup[]
  goals        Goal[]
  documents    Document[]
  wallets      Wallet[]
  timeline     TimelineEvent[]
  pushSubscriptions PushSubscription[]
}

model Wallet {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("bank") // bank | va | vr | digital | cash | investment
  balance   Float    @default(0)
  color     String?  @default("#ccff00")
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Transaction {
  id          String          @id @default(cuid())
  amount      Float
  type        String // "INCOME" or "EXPENSE"
  category    String
  description String
  date        DateTime

  paymentMethod String?
  installments Int?
  totalInstallments Int?
  notes       String?
  attachment  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  billId   String?
  bill     Bill?    @relation(fields: [billId], references: [id])
}

model BillGroup {
  id          String   @id @default(cuid())
  name        String
  icon        String?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bills       Bill[]
  folders     DocumentFolder[]
}

model DocumentFolder {
  id        String     @id @default(cuid())
  name      String
  createdAt DateTime   @default(now())
  
  userId    String
  groupId   String?
  group     BillGroup? @relation(fields: [groupId], references: [id])
  documents Document[]
}

model Bill {
  id          String     @id @default(cuid())
  name        String
  amount      Float
  dueDate     DateTime
  description String?
  pixKey      String?
  barcode     String?
  status      String     @default("PENDING") // PENDING, PAID, OVERDUE

  category    String?
  recurrent   Boolean    @default(false)
  paidAt      DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId      String?
  group        BillGroup?    @relation(fields: [groupId], references: [id])
  transactions Transaction[]
  documents    Document[]
}

model Goal {
  id          String     @id @default(cuid())
  name        String
  category    String
  limitAmount Float?
  targetAmount Float?
  currentAmount Float    @default(0)
  type        String     // LIMIT, SAVINGS
  period      String     @default("monthly") // "monthly" | "yearly"
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]
}

model GoalContribution {
  id        String   @id @default(cuid())
  amount    Float
  type      String   // ADD | SUBTRACT
  walletId  String?
  walletName String?
  date      DateTime @default(now())

  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Document {
  id            String       @id @default(cuid())
  name          String
  url           String
  type          String       // "pdf" | "jpg" | "png"
  size          Int
  referenceDate DateTime?    // Referente a:
  status        String       @default("PENDING")
  category      String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  billId        String?
  bill          Bill?          @relation(fields: [billId], references: [id])
  folderId      String?
  folder        DocumentFolder? @relation(fields: [folderId], references: [id])
}

model TimelineEvent {
  id          String   @id @default(cuid())
  type        String   // expense, income, alert, insight, goal, admin
  profileType String?  @default("INTELLIGENCE") // INTELLIGENCE, FINANCE, NOTICIAS, ADMIN
  title       String
  description String
  amount      Float?
  category    String?
  metadata    Json?    // For extra data like category comparison %
  isPublic    Boolean  @default(false) // If true, show to everyone
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String?  // Null if isPublic
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}
